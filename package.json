{
  "name": "silent-failure-lint-js",
  "version": "0.1.0",
  "description": "AST-based CLI that finds silently-swallowed errors in JS/TS async code: empty catch blocks, Promise.all() rejection leaks, fetch() calls with no timeout, and .then() with no .catch().",
  "bin": {
    "silent-failure-lint-js": "bin/sflint.js",
    "sflint-js": "bin/sflint.js"
  },
  "type": "commonjs",
  "main": "src/checks.js",
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "lint",
    "linter",
    "static-analysis",
    "async",
    "promises",
    "error-handling",
    "typescript",
    "javascript",
    "cli"
  ],
  "author": "StackScribe AI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stackscribe-ai/silent-failure-lint-js.git"
  },
  "homepage": "https://github.com/stackscribe-ai/silent-failure-lint-js#readme",
  "bugs": {
    "url": "https://github.com/stackscribe-ai/silent-failure-lint-js/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@typescript-eslint/typescript-estree": "^8.0.0"
  }
}
